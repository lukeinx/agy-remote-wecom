{
  "agy-remote-wecom": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./hook.mjs",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hook.mjs",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file|delete_file|ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hook.mjs",
            "timeout": 620
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hook.mjs",
        "timeout": 10
      }
    ]
  }
}
